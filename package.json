{
  "name": "myref",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "up": "docker compose up -d --build",
    "down": "docker compose down",
    "logs": "docker compose logs -f backend",
    "cli": "docker compose exec backend bun run cli",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db",
    "db:push": "bun run --cwd backend db:push",
    "db:generate": "bun run --cwd backend db:generate",
    "dev:api": "bun run --cwd backend dev",
    "dev:web": "bun run --cwd frontend dev",
    "dev": "bun run dev:api & bun run dev:web",
    "build": "bun run --cwd frontend build",
    "start": "bun run --cwd backend start",
    "typecheck": "bun run --cwd backend typecheck && bun run --cwd frontend typecheck",
    "setup": "bun install && docker compose up -d && bun run db:push"
  }
}
