# Docker Postgres
POSTGRES_USER=myref
POSTGRES_PASSWORD=myref
POSTGRES_DB=myref
POSTGRES_PORT=5432

# Backend
DATABASE_URL=postgres://myref:myref@localhost:5432/myref
PORT=3000
NODE_ENV=development
APP_ORIGIN=http://localhost:5173
# Set to false to disable new account registration (default: true)
REGISTRATION_ENABLED=true
# Production TLS: compose sets NODE_ENV=production and TLS_CERT_PATH /
# TLS_KEY_PATH automatically (./certs is a localhost-only placeholder —
# mount real certs, or terminate TLS at a reverse proxy and set
# TRUST_PROXY=true instead; see certs/README.md).
# TLS_CERT_PATH=/certs/cert.pem
# TLS_KEY_PATH=/certs/key.pem
# TRUST_PROXY=false
# Error tracking (optional, off when empty): unexpected server errors are
# reported to Sentry. Tracing stays disabled to avoid request overhead.
# SENTRY_DSN=

# Docker: `bun run up` builds and starts db + backend (backend on PORT).
# In containers DATABASE_URL and APP_ORIGIN are set by compose automatically.
# Reset a password from the running container:
#   docker compose exec backend bun run cli -- reset-password user@example.com new-password
